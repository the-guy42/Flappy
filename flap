<!DOCTYPE html> 
<html lang="en"> 
<head> 
  <meta charset="UTF-8"> 
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
  <title>Flappy Bird</title> 
  <style> 
    * { box-sizing: border-box; } 
    body { 
      margin: 0; 
      min-height: 100vh; 
      display: grid; 
      place-items: center; 
      background: #18202f; 
      font-family: Arial, sans-serif; 
      color: white; 
    } 
    .game { 
      position: relative; 
      width: min(420px, 95vw); 
      text-align: center; 
    } 
    h1 { 
      margin: 0 0 12px; 
      color: #ffe66d; 
    } 
    canvas { 
      width: 100%; 
      display: block; 
      border: 4px solid white; 
      border-radius: 12px; 
      cursor: pointer; 
      touch-action: manipulation; 
    } 
    .info { 
      margin-top: 12px; 
      color: #cbd5e1; 
    } 
    button { 
      background: #ffe66d; 
      color: #18202f; 
      font-size: 17px; 
      font-weight: bold; 
      border: 0; 
      border-radius: 8px; 
      padding: 12px 24px; 
      cursor: pointer; 
      margin-top: 10px; 
    } 
    button:hover { 
      background: #fff19b; 
    } 
  </style> 
</head> 
<body> 
  <div class="game"> 
    <h1>🐤 Flappy Bird</h1> 
    <canvas id="canvas" width="400" height="600"></canvas> 
    <div class="info">Spacebar / Click / Tap to flap</div> 
    <button id="restart">Start Game</button> 
  </div> 

  <script> 
    const canvas = document.getElementById("canvas"); 
    const ctx = canvas.getContext("2d"); 
    const button = document.getElementById("restart"); 
    const W = canvas.width; 
    const H = canvas.height; 
    const ground = 550; 
    let bird, pipes, score, best, frame, state; 
    
    best = Number(localStorage.getItem("flappyBest")) || 0; 

    function reset() { 
      bird = { x: 95, y: 260, velocity: 0, radius: 14 }; 
      pipes = []; 
      score = 0; 
      frame = 0; 
      state = "ready"; 
      button.textContent = "Start Game"; 
      draw(); 
    } 

    function start() { 
      if (state === "over") reset(); 
      state = "playing"; 
      bird.velocity = -6.5; 
      button.textContent = "Restart Game"; 
    } 

    function flap() { 
      if (state === "ready") { 
        start(); 
      } else if (state === "playing") { 
        bird.velocity = -6.5; 
      } else { 
        reset(); 
        start(); 
      } 
    } 

    canvas.addEventListener("pointerdown", (e) => { 
      e.preventDefault(); 
      flap(); 
    }); 

    button.addEventListener("click", () => { 
      if (state !== "playing") { 
        if (state === "over") reset(); 
        start(); 
      } else { 
        reset(); 
      } 
    }); 

    document.addEventListener("keydown", (e) => { 
      if (e.code === "Space" || e.code === "ArrowUp") { 
        e.preventDefault(); 
        if (!e.repeat) flap(); 
      } 
      if (e.code === "Enter" && state !== "playing") { 
        if (state === "over") reset(); 
        start(); 
      } 
    }); 

    function addPipe() { 
      const gap = 155; 
      const top = 65 + Math.random() * 245; 
      pipes.push({ x: W, top, bottom: top + gap, scored: false }); 
    } 

    function endGame() { 
      state = "over"; 
      button.textContent = "Play Again"; 
      if (score > best) { 
        best = score; 
        localStorage.setItem("flappyBest", best); 
      } 
    } 

    function update() { 
      if (state !== "playing") return; 
      frame++; 
      bird.velocity += 0.34; 
      bird.y += bird.velocity; 
      if (frame % 95 === 0) addPipe(); 
      for (const p of pipes) { 
        p.x -= 2.7; 
        if (!p.scored && p.x + 62 < bird.x) { 
          p.scored = true; 
          score++; 
        } 
        const hitX = bird.x + bird.radius > p.x && bird.x - bird.radius < p.x + 62; 
        const hitY = bird.y - bird.radius < p.top || bird.y + bird.radius > p.bottom; 
        if (hitX && hitY) endGame(); 
      } 
      pipes = pipes.filter(p => p.x > -70); 
      if (bird.y - bird.radius < 0 || bird.y + bird.radius > ground) { 
        endGame(); 
      } 
    } 

    function drawBackground() { 
      const sky = ctx.createLinearGradient(0, 0, 0, ground); 
      sky.addColorStop(0, "#65c8ff"); 
      sky.addColorStop(1, "#d2f5ff"); 
      ctx.fillStyle = sky; 
      ctx.fillRect(0, 0, W, H); 
      
      // Clouds 
      ctx.fillStyle = "rgba(255,255,255,0.8)"; 
      for (const c of [[65,100],[290,160],[180,55]]) { 
        ctx.beginPath(); 
        ctx.arc(c[0], c[1], 20, 0, Math.PI * 2); 
        ctx.arc(c[0]+22, c[1]+4, 16, 0, Math.PI * 2); 
        ctx.arc(c[0]-20, c[1]+7, 13, 0, Math.PI * 2); 
        ctx.fill(); 
      } 
      
      // Ground 
      ctx.fillStyle = "#ded895"; 
      ctx.fillRect(0, ground, W, H-ground); 
      ctx.fillStyle = "#65c94c"; 
      ctx.fillRect(0, ground, W, 12); 
      ctx.fillStyle = "#b4a66a"; 
      for (let x = 0; x < W; x += 32) { 
        ctx.fillRect(x, ground + 20, 16, 5); 
      } 
    } 

    function drawPipes() { 
      for (const p of pipes) { 
        ctx.fillStyle = "#38bd43"; 
        ctx.fillRect(p.x, 0, 62, p.top - 22); 
        ctx.fillRect(p.x, p.bottom + 22, 62, ground - p.bottom - 22); 
        ctx.fillStyle = "#229b35"; 
        ctx.fillRect(p.x + 7, 0, 9, p.top - 22); 
        ctx.fillRect(p.x + 7, p.bottom + 22, 9, ground - p.bottom - 22); 
        ctx.fillStyle = "#35c849"; 
        ctx.fillRect(p.x - 5, p.top - 22, 72, 22); 
        ctx.fillRect(p.x - 5, p.bottom, 72, 22); 
        ctx.strokeStyle = "#177b2b"; 
        ctx.lineWidth = 2; 
        ctx.strokeRect(p.x - 5, p.top - 22, 72, 22); 
        ctx.strokeRect(p.x - 5, p.bottom, 72, 22); 
      } 
    } 

    function drawBird() { 
      ctx.save(); 
      ctx.translate(bird.x, bird.y); 
      ctx.rotate(Math.min(Math.PI / 4, bird.velocity * 0.06)); 
      
      // Body 
      ctx.fillStyle = "#ffdf42"; 
      ctx.beginPath(); 
      ctx.arc(0, 0, bird.radius, 0, Math.PI * 2); 
      ctx.fill(); 
      ctx.strokeStyle = "#c38b20"; 
      ctx.lineWidth = 2; 
      ctx.stroke(); 
      
      // Wing 
      ctx.fillStyle = "#ffb52e"; 
      ctx.beginPath(); 
      ctx.ellipse(-5, 4, 8, 5, -0.3, 0, Math.PI * 2); 
      ctx.fill(); 
      
      // Eye 
      ctx.fillStyle = "white"; 
      ctx.beginPath(); 
      ctx.arc(6, -5, 5, 0, Math.PI * 2); 
      ctx.fill(); 
      ctx.fillStyle = "#172033"; 
      ctx.beginPath(); 
      ctx.arc(8, -5, 2.5, 0, Math.PI * 2); 
      ctx.fill(); 
      
      // Beak 
      ctx.fillStyle = "#ff783e"; 
      ctx.beginPath(); 
      ctx.moveTo(12, 0); 
      ctx.lineTo(23, 4); 
      ctx.lineTo(12, 7); 
      ctx.closePath(); 
      ctx.fill(); 
      ctx.restore(); 
    } 

    function drawText(text, y, size = 25) { 
      ctx.font = `bold ${size}px Arial`; 
      ctx.textAlign = "center"; 
      ctx.lineWidth = 4; 
      ctx.strokeStyle = "#31516a"; 
      ctx.strokeText(text, W/2, y); 
      ctx.fillStyle = "white"; 
      ctx.fillText(text, W/2, y); 
    } 

    function draw() { 
      drawBackground(); 
      drawPipes(); 
      drawBird(); 
      ctx.fillStyle = "#ffffff"; 
      ctx.textAlign = "center"; 
      ctx.font = "bold 42px Arial"; 
      ctx.lineWidth = 4; 
      ctx.strokeStyle = "#31516a"; 
      ctx.strokeText(score, W/2, 65); 
      ctx.fillText(score, W/2, 65); 
      ctx.font = "bold 15px Arial"; 
      ctx.textAlign = "left"; 
      ctx.fillStyle = "#23445b"; 
      ctx.fillText("BEST: " + best, 12, 28); 
      
      if (state === "ready") { 
        drawText("FLAPPY BIRD", 225, 30); 
        drawText("Click or press SPACE", 270, 17); 
        drawText("to start flying!", 295, 17); 
      } 
      
      if (state === "over") { 
        ctx.fillStyle = "rgba(15,30,50,0.65)"; 
        ctx.fillRect(25, 190, W-50, 190); 
        drawText("GAME OVER", 245, 32); 
        drawText("Score: " + score, 290, 23); 
        drawText("Best: " + best, 325, 20); 
        drawText("Click to play again", 355, 16); 
      } 
    } 

    function loop() { 
      update(); 
      draw(); 
      requestAnimationFrame(loop); 
    } 

    reset(); 
    loop(); 
  </script> 
</body> 
</html>
